# local: SQLite database with seeded accounts; supabase: managed PostgreSQL + Auth
DATA_BACKEND=local
# Required only with DATA_BACKEND=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# No service role key is used by this application.
# Local demo accounts are documented in README; do not expose local mode publicly.
